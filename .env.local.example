# ============================================================
# Variables de entorno
# ------------------------------------------------------------
# 1. Copia este archivo y renombra la copia como  .env.local
# 2. Rellena cada valor con los tuyos.
# 3. NUNCA subas .env.local a internet (ya está en .gitignore).
# ============================================================

# --- Supabase ---
# Los encuentras en el panel de Supabase:
#   Project Settings  >  API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# La clave "service_role" es SECRETA: tiene control total de la base de
# datos. Solo se usa en el servidor. NUNCA la pongas en una variable que
# empiece por NEXT_PUBLIC_ (esas viajan al navegador).
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta

# El panel de administración usa Supabase Auth (correo + contraseña), así
# que no hace falta ninguna otra variable aquí: no hay hash de contraseña
# ni secreto de cookie que configurar a mano. El primer super_admin se crea
# con "node --env-file=.env.local scripts/crear-super-admin.mjs" (ver README).

# --- Opcionales ---
# Dominio público del sitio (para la vista previa al compartir el enlace y
# el sitemap). En Vercel no hace falta: se toma solo del dominio de
# producción. Ejemplo: https://ecosim.co
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Aviso por correo cuando alguien llena el formulario de contacto de la
# landing. Sin estas dos variables no se envía nada (las solicitudes se
# siguen viendo en el panel, pestaña Solicitudes). Clave gratis en
# resend.com. AVISO_SOLICITUDES_DE solo hace falta si verificas tu propio
# dominio en Resend (si no, se usa su remitente de pruebas).
# RESEND_API_KEY=re_xxxxxxxx
# AVISO_SOLICITUDES_A=tu-correo@ejemplo.com
# AVISO_SOLICITUDES_DE=EcoSim <avisos@tu-dominio.com>
