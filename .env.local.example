# ============================================================
# Variables de entorno
# ------------------------------------------------------------
# 1. Copia este archivo y renombra la copia como  .env.local
# 2. Rellena cada valor con los tuyos.
# 3. NUNCA subas .env.local a internet (ya está en .gitignore).
# ============================================================

# --- Supabase ---
# Los encuentras en el panel de Supabase:
#   Project Settings  >  API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# La clave "service_role" es SECRETA: tiene control total de la base de
# datos. Solo se usa en el servidor. NUNCA la pongas en una variable que
# empiece por NEXT_PUBLIC_ (esas viajan al navegador).
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta

# --- Panel de administración ---
# Hash de la contraseña del admin. NO pongas la contraseña en claro:
# genera el hash con este comando (ver README):
#   node scripts/generar-hash.mjs "tu-contraseña"
ADMIN_PASSWORD_HASH=pega-aqui-el-hash-generado

# Secreto para firmar la cookie de sesión del admin.
# Pon una cadena larga y aleatoria (40+ caracteres). Genera una con:
#   node scripts/generar-hash.mjs --secreto
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
